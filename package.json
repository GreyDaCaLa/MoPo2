{
  "name": "mopo2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w shared",
    "simulate": "node shared/src/simulate.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
